# Copiá este archivo a .env. No lo subas al repo.
JWT_KEY=genera_una_clave_con_openssl_rand_base64_48
POSTGRES_PASSWORD=cambia_esta_clave
DB_APP_PASSWORD=cambia_esta_clave
# Opcional: SWAGGER_ENABLED=true para exponer Swagger en un entorno de demo.
SWAGGER_ENABLED=false
# Opcional: proveedor de IA. Sin clave, el asistente usa el modo de reglas.
GROQ_API_KEY=
ASISTENTE_MODEL=openai/gpt-oss-20b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
