<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- `dotnet user-secrets set "Jwt:Key" ...` (never commit the key). -->
    <UserSecretsId>sipa-mini-identity-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <!-- Pinned: 2.4.1 (transitive from Swashbuckle) is affected by CVE-2026-49451 (patched in 2.7.5). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniIdentityApi.Application\MiniIdentityApi.Application.csproj" />
    <ProjectReference Include="..\MiniIdentityApi.Infrastructure\MiniIdentityApi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
